# NaijaShield AI Environment Variables
# Get your free Gemini API key from https://aistudio.google.com/app/apikey

# Required on Vercel (Production Serverless Proxy - keeps key hidden from browser):
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Local Development (npm run dev):
VITE_GEMINI_API_KEY=your_gemini_api_key_here
